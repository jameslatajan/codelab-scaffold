<!-- JS Functions -->
<script>
    // Data from Controller
    const savedParticipants = <?php echo json_encode($participants); ?>;

    // Initialize date picker (if needed, though not used in main form, maybe in partials)
    flatpickr('.flatpickr-basic', {
        dateFormat: 'm/d/Y'
    });

    $(document).on('change', '#secID', function() {
        const secID = $(this).val();
        $('#sectionEmployeesBody').html('');
        if (!secID) return;
        $.ajax({
            type: "GET",
            url: "<?php echo $controller_page . '/get_section_employees' ?>",
            data: {
                secID
            },
            dataType: "json",
            success: function(res) {
                if (res.status !== 200) {
                    Swal.fire(res.title, res.message, "warning");
                    return;
                }
                if (!res.data || res.data.length === 0) {
                    $('#sectionEmployeesBody').html('<tr><td colspan="3" class="text-center text-muted">No data found</td></tr>');
                    return;
                }
                const rows = res.data.map(e => {
                    const isChecked = selections.employees.has(e.id) ? 'checked' : '';
                    return `<tr>
                        <td><input type="checkbox" class="form-check-input check-item" name="employees[]" value="${e.id}" ${isChecked} style="width: 20px; height: 20px;"></td>
                        <td data-idno="${e.idNo}">${e.idNo}</td>
                        <td data-fullname="${e.fullName}">${e.fullName}</td>
                    </tr>`;
                });

                $('#sectionEmployeesBody').html(rows.join(''));
            },
            error: function(xhr) {
                if (xhr.responseJSON) {
                    Swal.fire(xhr.responseJSON.title, xhr.responseJSON.message, "error");
                } else {
                    Swal.fire("Error", xhr.status + ": " + xhr.statusText, "error");
                }
            }
        });
    });

    function loadParticipantDiv(type) {
        if (type == 1) {
            $('.participant-div').html(`<?php echo $this->include('modules/trainings/nominations/multiple_div'); ?>`);
            $('#employeeTypes').removeClass('d-none').next('.select2-container').show();
            $('.select2-empTypes').select2();
        } else if (type == 2) {
            $('.participant-div').html(`<?php echo $this->include('modules/trainings/nominations/multiple_sec'); ?>`);
            $('#employeeTypes').removeClass('d-none').next('.select2-container').show();
            $('.select2-empTypes').select2();
        } else if (type == 3) {
            $('.participant-div').html(`<?php echo $this->include('modules/trainings/nominations/section_emp'); ?>`);
            $('.select2-section').select2();
            $('#employeeTypes').addClass('d-none').next('.select2-container').hide();
        } else if (type == 4) {
            $('.participant-div').html(`<?php echo $this->include('modules/trainings/nominations/individual_emp'); ?>`);
            initIndividualSearch();
            $('#employeeTypes').addClass('d-none').next('.select2-container').hide();
        }
        bindSelectionHandlers();
    }

    function initIndividualSearch() {
        $('#empID').select2({
            placeholder: 'Press Enter to search',
            minimumInputLength: 1,
            language: {
                inputTooShort: function() {
                    return "Press Enter to search";
                },
                searching: function() {
                    return "Searching...";
                },
                noResults: function() {
                    return "No results found";
                }
            },
            ajax: {
                url: "<?php echo $controller_page . '/search_employees' ?>",
                type: 'GET',
                dataType: 'json',
                delay: 250,
                data: function(params) {
                    return {
                        value: params.term
                    };
                },
                processResults: function(data) {
                    return {
                        results: data.data.records
                    };
                },
                cache: true
            },
        }).on('select2:open', function() {
            let searchBox = $('.select2-search__field');
            searchBox.off();
            $('.select2-results__options').html(
                '<li class="select2-results__option" role="treeitem" aria-disabled="true">Press Enter to search</li>'
            );
            searchBox.on('keypress', function(e) {
                if (e.keyCode === 13) {
                    e.preventDefault();
                    let term = $(this).val();
                    let select2Control = $('#empID').data('select2');
                    $('.select2-results__options').empty();
                    select2Control.trigger('query', {
                        term: term
                    });
                }
            });
        });
    }

    const selections = {
        divisions: new Map(),
        sections: new Map(),
        employees: new Map()
    };

    function clearSelections() {
        selections.divisions.clear();
        selections.sections.clear();
        selections.employees.clear();
        $('#selectedList').empty();
        // remove hidden inputs
        $('#frmEntry input[name="divisions[]"]').remove();
        $('#frmEntry input[name="sections[]"]').remove();
        $('#frmEntry input[name="employees[]"]').remove();
        $('#empSearchBody').empty(); // Also clear the table for Type 4
    }

    function addHidden(type, id) {
        const name = type === 'divisions' ? 'divisions[]' : type === 'sections' ? 'sections[]' : 'employees[]';
        $('#frmEntry').append(`<input type="hidden" name="${name}" value="${id}">`);
    }

    function removeHidden(type, id) {
        const name = type === 'divisions' ? 'divisions[]' : type === 'sections' ? 'sections[]' : 'employees[]';
        $(`#frmEntry input[name="${name}"][value="${id}"]`).remove();
    }

    function bindSelectionHandlers() {
        // Select all toggler
        $('.participant-div').off('change', '.check-all').on('change', '.check-all', function() {
            const checked = $(this).is(':checked');
            const $table = $(this).closest('table');
            $table.find('.check-item').prop('checked', checked).trigger('change');
        });

        // Add button (Individual Employee)
        $('.participant-div').off('click', '#btnAdd').on('click', '#btnAdd', function() {
            addEmployee();
        });

        // Item toggle
        $('.participant-div').off('change', '.check-item').on('change', '.check-item', function() {
            const $row = $(this).closest('tr');
            const id = $(this).val();
            const type = $('#participantType').val();
            let label = '';
            if (type == '1') {
                // Division
                label = $row.find('td').eq(1).text().trim() + ' - ' + $row.find('td').eq(2).text().trim();
                if ($(this).is(':checked')) {
                    selections.divisions.set(id, label);
                    addHidden('divisions', id);
                } else {
                    selections.divisions.delete(id);
                    removeHidden('divisions', id);
                }
            } else if (type == '2') {
                // Section
                label = $row.find('td').eq(1).text().trim() + ' - ' + $row.find('td').eq(2).text().trim();
                if ($(this).is(':checked')) {
                    selections.sections.set(id, label);
                    addHidden('sections', id);
                } else {
                    selections.sections.delete(id);
                    removeHidden('sections', id);
                }
            } else if (type == '3' || type == '4') {
                // Employees
                const idNo = $row.find('[data-idno]').data('idno') || $row.find('td').eq(1).text().trim();
                const name = $row.find('[data-fullname]').data('fullname') || $row.find('td').eq(2).text().trim();
                label = idNo + ' - ' + name;
                if ($(this).is(':checked')) {
                    selections.employees.set(id, label);
                    addHidden('employees', id);
                } else {
                    selections.employees.delete(id);
                    removeHidden('employees', id);
                }
            }
            renderSelected();
        });

        // Remove from selected list
        $('#selectedList').off('click', '.remove-tag').on('click', '.remove-tag', function() {
            const id = $(this).data('id');
            const type = $(this).data('type');
            if (type === 'divisions') {
                selections.divisions.delete(id);
            } else if (type === 'sections') {
                selections.sections.delete(id);
            } else {
                selections.employees.delete(id);
            }
            removeHidden(type, id);
            // Uncheck the corresponding checkbox if visible
            $('.participant-div .check-item').each(function() {
                if ($(this).val() === id) $(this).prop('checked', false);
            });
            renderSelected();
        });
    }

    function renderSelected() {
        let html = '';
        selections.divisions.forEach((label, id) => {
            html += `<span class="badge bg-primary me-1 mb-1">${label} <i class="fas fa-times remove-tag cursor-pointer" data-id="${id}" data-type="divisions"></i></span>`;
        });
        selections.sections.forEach((label, id) => {
            html += `<span class="badge bg-info me-1 mb-1">${label} <i class="fas fa-times remove-tag cursor-pointer" data-id="${id}" data-type="sections"></i></span>`;
        });
        selections.employees.forEach((label, id) => {
            html += `<span class="badge bg-success me-1 mb-1">${label} <i class="fas fa-times remove-tag cursor-pointer" data-id="${id}" data-type="employees"></i></span>`;
        });
        $('#selectedList').html(html);
    }

    function check_fields(frm) {
        let valid = true;
        let missing = "";

        $(frm + ' [required]').each(function() {
            if ($(this).val() === '') {
                missing += "<br/>" + $(this).attr('title');
                valid = false;
            }
        });

        if (!valid) {
            Swal.fire("Required Fields", missing, "warning");
        }

        return valid;
    }

    function addEmployee() {
        const data = $('#empID').select2('data');
        if (!data || data.length === 0) {
            Swal.fire("Add Employee", "Please select an employee first.", "warning");
            return;
        }
        const emp = data[0]; // {id, text}
        addEmployeeRow(emp.id, emp.text);

        // Clear selection
        $('#empID').val('');
        initIndividualSearch();
    }

    function addEmployeeRow(id, text) {
        // Check if already in table
        if ($(`#empSearchBody input[value="${id}"]`).length > 0) {
            // Already added
            return;
        }

        const parts = text.split(' - ');
        const idNo = parts[0] || '';
        const name = parts.slice(1).join(' - ') || text;

        const row = `<tr>
            <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-emp rounded-pill"><i class="fa fa-trash"></i></button></td>
            <td>
                <input type="hidden" name="employees[]" value="${id}">
                ${idNo}
            </td>
            <td>${name}</td>
        </tr>`;

        // If table has the "empty" rows (colspan), clear them
        if ($('#empSearchBody tr td[colspan]').length > 0) {
            $('#empSearchBody').empty();
        }

        $('#empSearchBody').append(row);
    }

    // Remove employee from individual list
    $(document).on('click', '.remove-emp', function() {
        $(this).closest('tr').remove();
    });


    // ==========================
    // 💾 Save Button Handler
    // ==========================
    $('#cmdUpdate').on('click', function() {
        if (!check_fields('#frmEntry')) return;

        const $btn = $(this);
        const btnText = $btn.html();
        const formData = new FormData($('#frmEntry')[0]);

        Swal.fire({
            title: 'Are you sure?',
            text: 'You are going to update this data. Do you wish to proceed?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: "#4D62C5",
            cancelButtonColor: "#636678",
            processData: false,
            contentType: false,
            confirmButtonText: "Yes"
        }).then(result => {
            if (result.isConfirmed) {
                $.ajax({
                    type: "POST",
                    url: "<?php echo $controller_page . '/update' ?>",
                    data: formData,
                    dataType: "json",
                    processData: false,
                    contentType: false,
                    beforeSend: function() {
                        $btn.html(`<div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Loading...</span>
                      </div>`);
                    },
                    success: function(response) {
                        Swal.fire({
                            title: response.title,
                            text: response.message,
                            icon: 'success',
                            confirmButtonText: "Ok"
                        }).then(() => {
                            window.location.replace(response.data.url);
                        });
                    },
                    error: function(xhr) {
                        if (xhr.responseJSON) {
                            Swal.fire(xhr.responseJSON.title, xhr.responseJSON.message, "error");
                        } else {
                            Swal.fire("Error", xhr.status + ": " + xhr.statusText, "error");
                        }
                    },
                    complete: function() {
                        $btn.html(btnText);
                    }
                });
            }
        });
    });

    // ==========================
    // ❌ Cancel Button
    // ==========================
    $('#cmdCancel').on('click', function() {
        cancel_confirmation('<?php echo $controller_page . '/view/' . $encrypter->encode($rec->{$pfield}); ?>');
    });

    // Initialize with default selection on load
    $(function() {
        loadParticipantDiv(4);

        // Populate the list with existing participants
        if (savedParticipants && savedParticipants.length > 0) {
            savedParticipants.forEach(p => {
                addEmployeeRow(p.id, p.text);
            });
        }
    });
</script>

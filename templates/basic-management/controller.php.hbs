    public function view($id)
    {
        $this->submenu();
        $data = $this->data;

        $id = encrypter_decrypt($id);

        if ($this->roles['view']) {
            // Signatory definitions (easy to edit!)
            $signatoriesConfig = [];

            /* Base columns */
            $b = $this->db->table($this->table);
            $b->select($this->table . '.' . $this->pfield);
            $b->select($this->table . '.*');

            // Dynamic signatory + date fields + joins
            if ($signatoriesConfig) {
                foreach ($signatoriesConfig as $s) {
                    // signatory ID column
                    $b->select("{$this->table}.{$s['column']}");
                    // date column
                    $b->select("{$this->table}.{$s['dateCol']}");
                    // Join user table
                    $alias = "{$s['key']}_user";
                    $b->select("{$alias}.firstName AS {$s['key']}_firstname");
                    $b->select("{$alias}.middleName AS {$s['key']}_middlename");
                    $b->select("{$alias}.lastName AS {$s['key']}_lastname");
                    $b->join("users AS {$alias}", "{$this->table}.{$s['column']} = {$alias}.userID", 'left');
                }
            }

            $b->where($this->pfield, $id);
            $data['rec'] = $rec = $b->get()->getRow();

            $data['signatories'] = [];
            if ($signatoriesConfig) {
                foreach ($signatoriesConfig as $s) {
                    $fname  = "{$s['key']}_firstname";
                    $lname  = "{$s['key']}_lastname";
                    $date   = $s['dateCol'];
                    $col    = $s['column'];

                    // only show if id is exist in the column
                    $show = false;
                    if ($rec->$col) {
                        $show = true;
                    }
                    $data['signatories'][] = [
                        'no'       => $s['no'],
                        'show'     => $show,
                        'label'    => $s['label'],
                        'value'    => ($rec->$col) ? strtoupper($rec->$lname . ', ' . $rec->$fname) : '-',
                        'subTitle' => (strtotime($rec->$date) > 1) ? date('F d, Y h:i A', strtotime($rec->$date)) : '-',
                        'theme'    => ($rec->$col) ? $s['theme'] : '',
                    ];
                }
            }

            // log url
            $data['logUrl'] = $logUrl = site_url('logs/single_record_log/' . $this->table . '/' . $this->pfield . '/' . $this->encrypter->encode($rec->{$this->pfield}) . '/' . $this->sub);

            // Load views
            echo view('header', $data);
            echo view($this->module_path . "/view");
            echo view('footer');
        } else {
            $data['page_title'] = 'Unauthorized';
            $data['page_desc']  = 'You dont have access to this page';
            $data['url']        = $this->controller_page;

            echo view('header', $data);
            echo view("default");
            echo view('footer');
        }
    }


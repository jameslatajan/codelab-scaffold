    public function save()
    {
        $this->submenu();

        /*
        initialize
        */
        $logModel = new LogModel();
        $checker = new Checker();

        if ($this->roles['create']) {
            $table_fields = array(
                '{{mainField}}',
            );

            $fields = array();
            foreach ($table_fields as $fld) {
                $fields[$fld] = trim($this->request->getPost($fld));
            }

            // check duplicate
            if ($checker->check_duplicate('{{mainField}}', $fields['{{mainField}}'], $this->table)) {
                $res['status']  = $status = 409;
                $res['title']   = 'Saving data';
                $res['message'] = 'Duplicate record found';
                $res['data']    = array();

                return $this->response->setStatusCode($status)->setJSON($res);
            }

            $fields['status'] = 1;

            $b = $this->db->table($this->table);
            if ($b->insert($fields)) {
                $id = $this->db->insertID();

                $logs = "Record - " . $this->sub;
                $logModel->table_logs($this->sub, $this->table, $this->pfield,  $id, 'Insert', $logs);
            }

            $encID = $this->encrypter->encode($id);

            $res['status']      = $status = 200;
            $res['title']       = 'Saved';
            $res['message']     = 'Data save successfully';
            $res['data']['url'] = $this->controller_page . '/view/' . $encID;

            return $this->response->setStatusCode($status)->setJSON($res);
        } else {
            $res['status']  = $status = 409;
            $res['title']   = 'Saving data';
            $res['message'] = 'You dont have access to this action';
            $res['data']    = array();

            return $this->response->setStatusCode($status)->setJSON($res);
        }
    }

    public function update()
    {
        $this->submenu();

        /*
        initialize
        */
        $logModel = new LogModel();
        $checker = new Checker();

        if ($this->roles['edit']) {
            $id     = $this->encrypter->decode($this->request->getPost($this->pfield));
            $action = 'Update';

            $table_fields = array(
                '{{mainField}}',
                'status',
            );

            $fields = array();
            foreach ($table_fields as $fld) {
                $fields[$fld] = trim($this->request->getPost($fld));
            }

            // check duplicate
            if ($checker->check_duplicate_edit('{{mainField}}', $fields['{{mainField}}'], $this->table, $this->pfield, $id)) {
                $res['status']  = $status = 409;
                $res['title']   = 'Saving data';
                $res['message'] = 'Duplicate record found';
                $res['data']    = array();

                return $this->response->setStatusCode($status)->setJSON($res);
            }

            // log field changes first
            $wasChange = $logModel->field_logs($this->sub, $this->table, $this->pfield, $id, 'Update', $fields);

            $b = $this->db->table($this->table);
            $b->set($fields);
            $b->where($this->pfield, $id);
            if ($b->update()) {
                if ($wasChange) {
                    $logs = 'Record - ' . $this->sub . ' ' . $action;
                    $logModel->table_logs($this->sub, $this->table, $this->pfield, $id, 'Update', $logs);
                }
            }

            $encID = $this->encrypter->encode($id);

            $res['status']      = $status = 200;
            $res['title']       = 'Saved';
            $res['message']     = 'Data ' . $action . '  successfully';
            $res['data']['url'] = $this->controller_page . '/view/' . $encID;

            return $this->response->setStatusCode($status)->setJSON($res);
        } else {
            $res['status']  = $status = 409;
            $res['title']   = 'Saving data';
            $res['message'] = 'You dont have access to this action';
            $res['data']    = array();

            return $this->response->setStatusCode($status)->setJSON($res);
        }
    }

